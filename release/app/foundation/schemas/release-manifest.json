{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:component-foundation:release-manifest:1.0.0",
  "title": "release-manifest contract version 1.0.0",
  "description": "Immutable package manifest. Runtime verifies a nonempty complete inventory, contained paths and exact SHA-256 values, which require semantic checks beyond the restricted schema validator.",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "version",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "files": {
      "type": "object",
      "additionalProperties": true
    },
    "foundation_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "foundation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scope": {},
    "capabilities": {},
    "excluded_capabilities": {},
    "dependencies": {},
    "platform": {},
    "acceptance_evidence": {},
    "licenses": {},
    "migration": {},
    "rollback": {},
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
