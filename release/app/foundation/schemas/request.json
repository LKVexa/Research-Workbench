{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:component-foundation:request:1.0.0",
  "title": "request contract version 1.0.0",
  "description": "Immutable request for a pinned allowlisted fixture capability. Per-component case eligibility is additionally checked by the runtime capability map.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "parent_run_id",
    "component_id",
    "case",
    "created_at",
    "foundation_version",
    "foundation_manifest_sha256",
    "timeout_seconds",
    "python_sha256",
    "baseline_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,79}$"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{7,79}$"
    },
    "component_id": {
      "type": "string",
      "pattern": "^D[0-9]{4}/[A-Za-z0-9_-]+$",
      "maxLength": 96
    },
    "case": {
      "type": "string",
      "enum": [
        "all",
        "initial",
        "correct",
        "regression",
        "baseline",
        "negative-control"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "foundation_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "foundation_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 60
    },
    "python_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
